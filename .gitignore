# Source PDFs: ~24 MB, regenerated by src/fetch_corpus.py
data/raw/

# Generated at runtime
output/
__pycache__/
*.pyc
.venv/
page-*.jpg
*.pdf

# NOTE: data/text/ is deliberately NOT ignored. It holds the extracted text of
# the published instruments and is what makes the reported figures reproducible
# by anyone who clones this repository, without needing network access to the
# issuing authorities - several of which block automated retrieval.

*.docx

*.docx
